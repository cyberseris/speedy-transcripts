# Browser-safe, RLS-gated. Same value Vercel needs under Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. Bypasses RLS entirely -- anyone holding this owns the database.
# Never prefix with NEXT_PUBLIC_, never reference it from a Client Component.
# Added in M1 Step 4 for the /api/jobs route handlers.
SUPABASE_SECRET_KEY=
